{
  "name": "@office/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/static --external:ws --external:zod --outfile=dist/index.js",
    "start": "node --no-warnings=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p .",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
