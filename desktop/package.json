{
  "name": "@office/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc -p .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2"
  },
  "productName": "Office",
  "description": "Office desktop app",
  "author": "amir-r-z-a"
}
